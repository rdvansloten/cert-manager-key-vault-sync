  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); command -v jq >/dev/null 2>&1 || { printf '%s\\n' 'guard could not run (jq not found); blocking the command - see CLAUDE.md' >&2; exit 2; }; printf '%s' \"$p\" | jq -e '.tool_input.command // \"\" | gsub(\"\\\\|&|&&|\\\\|\\\\||;|\\\\||&\"; \"\\n\") | split(\"\\n\") | map(sub(\"^[[:space:]]*(do|then|else|elif|\\\\{|\\\\()?[[:space:]]*\"; \"\") | sub(\"^([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*\"; \"\") | sub(\"^(sudo|command|builtin|env|time|nice|nohup|stdbuf|noglob)[[:space:]]+\"; \"\") | sub(\"^timeout[[:space:]]+[0-9]+[a-z]?[[:space:]]+\"; \"\") | sub(\"^(sudo|command|builtin|env|time|nice|nohup|stdbuf|noglob)[[:space:]]+\"; \"\")) | map(select(test(\"^az([[:space:]]|$)\"))) | map(select(test(\"(^|[^A-Za-z0-9-])(delete|purge)($|[^A-Za-z0-9-])\"))) | .[0]' >/dev/null 2>&1 && { printf '%s\\n' 'Destructive Azure CLI command (delete/purge) is blocked by repo policy - see CLAUDE.md' >&2; exit 2; }; exit 0"
          },
          {
            "type": "command",
            "command": "p=$(cat); command -v jq >/dev/null 2>&1 || { printf '%s\\n' 'guard could not run (jq not found); blocking the command - see CLAUDE.md' >&2; exit 2; }; printf '%s' \"$p\" | jq -e '.tool_input.command // \"\" | gsub(\"\\\\|&|&&|\\\\|\\\\||;|\\\\||&\"; \"\\n\") | split(\"\\n\") | map(sub(\"^[[:space:]]*(do|then|else|elif|\\\\{|\\\\()?[[:space:]]*\"; \"\") | sub(\"^([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*\"; \"\") | sub(\"^(sudo|command|builtin|env|time|nice|nohup|stdbuf|noglob)[[:space:]]+\"; \"\") | sub(\"^timeout[[:space:]]+[0-9]+[a-z]?[[:space:]]+\"; \"\") | sub(\"^(sudo|command|builtin|env|time|nice|nohup|stdbuf|noglob)[[:space:]]+\"; \"\")) | map(select(test(\"^az([[:space:]]|$)\"))) | map(select(test(\"keyvault[[:space:]]+(secret|certificate|key)[[:space:]]+(show|download|backup)\"))) | .[0]' >/dev/null 2>&1 && { printf '%s\\n' 'Reading Azure Key Vault secret, certificate or key values is blocked by repo policy - see CLAUDE.md. Listing names with az keyvault secret list is still allowed.' >&2; exit 2; }; exit 0"
          },
          {
            "type": "command",
            "command": "p=$(cat); command -v jq >/dev/null 2>&1 || { printf '%s\\n' 'guard could not run (jq not found); blocking the command - see CLAUDE.md' >&2; exit 2; }; printf '%s' \"$p\" | jq -e '.tool_input.command // \"\" | gsub(\"\\\\|&|&&|\\\\|\\\\||;|\\\\||&\"; \"\\n\") | split(\"\\n\") | map(sub(\"^[[:space:]]*(do|then|else|elif|\\\\{|\\\\()?[[:space:]]*\"; \"\") | sub(\"^([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*\"; \"\") | sub(\"^(sudo|command|builtin|env|time|nice|nohup|stdbuf|noglob)[[:space:]]+\"; \"\") | sub(\"^timeout[[:space:]]+[0-9]+[a-z]?[[:space:]]+\"; \"\") | sub(\"^(sudo|command|builtin|env|time|nice|nohup|stdbuf|noglob)[[:space:]]+\"; \"\")) | map(select(test(\"^kubectl([[:space:]]|$)\"))) | map(select(test(\"(get|edit)[[:space:]]+([^[:space:]]+[[:space:]]+)*secrets?([[:space:]/]|$)\"))) | map(select(test(\"(-o|--output)[[:space:]=]*(yaml|json|jsonpath|go-template|custom-columns|template)\"))) | .[0]' >/dev/null 2>&1 && { printf '%s\\n' 'Reading Kubernetes Secret values is blocked by repo policy - see CLAUDE.md. Use kubectl describe secret, or kubectl get secrets without an output format.' >&2; exit 2; }; exit 0"
          },
          {
            "type": "command",
            "command": "jq -c '.tool_input.command as $cmd | if ($cmd != null) and ($cmd | test(\"[.]tfstate\")) then {hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"Reading Terraform state file contents is blocked by repo policy - see CLAUDE.md. State files hold secret values in cleartext.\"}} else empty end'"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '.tool_input.file_path as $path | if ($path != null) and ($path | test(\"[.]tfstate\")) then {hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"Reading Terraform state file contents is blocked by repo policy - see CLAUDE.md. State files hold secret values in cleartext.\"}} else empty end'"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '([.tool_input.path, .tool_input.glob] | map(select(. != null)) | join(\" \")) as $target | if ($target | test(\"tfstate\")) then {hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"Reading Terraform state file contents is blocked by repo policy - see CLAUDE.md. State files hold secret values in cleartext.\"}} else empty end'"
          }
        ]
      }
    ]
